rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsNewRecord() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingRecord() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /transactions/{documentId} {
      allow create: if ownsNewRecord();
      allow read, delete: if ownsExistingRecord();
      allow update: if ownsExistingRecord() && ownsNewRecord();
    }

    match /trackedItems/{documentId} {
      allow create: if ownsNewRecord();
      allow read, delete: if ownsExistingRecord();
      allow update: if ownsExistingRecord() && ownsNewRecord();
    }

    match /debts/{documentId} {
      allow create: if ownsNewRecord();
      allow read, delete: if ownsExistingRecord();
      allow update: if ownsExistingRecord() && ownsNewRecord();
    }

    // All other collections are denied unless explicitly added above.
  }
}
